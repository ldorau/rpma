#
# Dockerfile - a 'recipe' for Docker to build an image of ubuntu-based
#              environment prepared for running tests of librpma.
#

# Pull base image
FROM archlinux:latest
MAINTAINER lukasz.dorau@intel.com

# Do full system upgrade
RUN pacman -Syu --noconfirm

# Install required packages
RUN pacman -S --noconfirm \
    clang-analyzer \
    cmake \
    flex \
    fuse3 \
    gcc \
    git \
    graphviz \
    hwloc \
    jdk8-openjdk \
    lcov \
    libaio \
    libiscsi \
    libtool \
    libunwind \
    libyaml \
    make \
    maven \
    ndctl \
    numactl \
    openmpi \
    patch \
    patchelf \
    python \
    python-pip \
    scons \
    sg3_utils \
    sudo \
    valgrind \
    yasm

# && rm -rf /var/cache/pacman/pkg/*

RUN pip3 install --upgrade pip

# Install cmocka
COPY install-cmocka.sh install-cmocka.sh
RUN ./install-cmocka.sh

# Add user
ENV USER user
ENV USERPASS p1a2s3s4
ENV PFILE ./password
RUN useradd -m $USER
RUN echo $USERPASS > $PFILE
RUN echo $USERPASS >> $PFILE
RUN passwd $USER < $PFILE
RUN rm -f $PFILE
RUN sed -i 's/# %wheel/%wheel/g' /etc/sudoers
RUN gpasswd wheel -a $USER

# Enable preserving given variables in the privileged environment -
# - it is required by 'makepkg' to download required packages and sources
RUN echo 'Defaults env_keep += "ftp_proxy http_proxy https_proxy no_proxy"' >> /etc/sudoers
RUN echo 'Defaults env_keep += "FTP_PROXY HTTP_PROXY HTTPS_PROXY NO_PROXY"' >> /etc/sudoers

RUN cd / && git clone --recurse-submodules -b release/2.0 https://github.com/daos-stack/daos.git

RUN chown -R $USER:$USER /daos
RUN echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
RUN echo "LANG=en_US.UTF-8" >> /etc/locale.conf
RUN /usr/bin/locale-gen
RUN /usr/bin/locale

RUN pacman -S --noconfirm \
	autoconf \
	automake \
	boost \
	boost-libs \
	pkgconf \
	python-distro

RUN pacman -S --noconfirm \
	fakeroot

# Install rdma-core
COPY install-archlinux-aur.sh install-archlinux-aur.sh
RUN ./install-archlinux-aur.sh rdma-core

RUN pacman -S --noconfirm \
	meson

# Switch to user
USER $USER

# Set required environment variables
ENV OS archlinux
ENV OS_VER latest
ENV PACKAGE_MANAGER none
ENV NOTTY 1

RUN locale
RUN pip3 install --user meson pyelftools
RUN cd /daos && pwd && ls -al && pwd && scons --config=force --build-deps=yes

